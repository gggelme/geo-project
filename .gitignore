# Ignorar el entorno virtual de uv / python
.venv/

# Configuración local
.env

# Ignorar cachés y temporales de Python y Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Matrices preparadas para EDA
.cache/eda/

# Caché de imágenes
.cache/modeling/
.cache/explorer/

# Checkpoints de entrenamiento (pesados); el resto de outputs/ se versiona
outputs/**/*.pt

*.parquet
# Logits de la evaluación final (pesados; se regeneran desde los snapshots)
outputs/**/logits/*.npy

# Dependencias de node de la presentación
presentacion/node_modules/
